[Unit]
Description=SealDesk
Requires=network.target
After=systemd-user-sessions.service

[Service]
Type=simple
ExecStart=/usr/bin/sealdesk --service
# kill --tray and --server both
ExecStop=pkill -f "sealdesk --"
# below two lines do not work, have to use above one line
#ExecStop=pkill -f "sealdesk --tray"
#ExecStop=pkill -f "sealdesk --server"
PIDFile=/run/sealdesk.pid
KillMode=mixed
TimeoutStopSec=30
User=root
LimitNOFILE=100000
Environment="PULSE_LATENCY_MSEC=60" "PIPEWIRE_LATENCY=1024/48000"

[Install]
WantedBy=multi-user.target
